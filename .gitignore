# Local system/editor state
.DS_Store
.claude/
.trash/

# Local label files may contain real business data; never publish them.
# They are development material, not part of the public repository.
labels/
*.zpl
*.300zpl
*.200zpl
*.prn

# Compiled output of the root Go server. The explicit project name is used by
# the README; /ZPLkit also covers Go's default directory-derived binary name.
/zpl-studio-server
/zpl-studio-server.exe
/ZPLkit
/ZPLkit.exe
# On case-insensitive filesystems the binary rule above also matches the
# tracked source directory. Explicitly keep new library modules visible.
!/zplkit/
/server.log

# Runtime-only printer configuration and templates may contain internal
# network details or label data and must never enter the public Pages tree.
/config/printers.csv
/templates/

# Local secrets and generated development artefacts.
.env
.env.*
!.env.example
*.pem
*.key
node_modules/
coverage/
